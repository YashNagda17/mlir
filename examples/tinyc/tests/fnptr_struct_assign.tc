extern int printf(const char *fmt, ...);
// Struct assignment must copy fnptr and int** fields (not scalar i32 chunks).

int add(int a, int b) { return a + b; }

typedef struct {
    int (*op)(int, int);
    int **ppi;
} Bundle;

int main(void) {
    int n = 9;
    int *pn = &n;
    Bundle a;
    Bundle b;
    a.op = add;
    a.ppi = &pn;
    b = a;
    printf("%lld\n", (long long)(b.op(2, 3)));
    printf("%lld\n", (long long)(**b.ppi));
    **b.ppi = 42;
    printf("%lld\n", (long long)(n));
    return 0;
}
